# ---------------------------------------------------------------------------
# Engine selection
# ---------------------------------------------------------------------------
# freecad (default) or solidcraft. FreeCAD is the engine this project is built
# on; SolidCraft is an opt-in alternative that adds a ~493-command parametric
# catalog and the command/batch/list_commands/describe_command job types.
PISTOLA_CAD_ENGINE=freecad

# ---------------------------------------------------------------------------
# FreeCAD engine
# ---------------------------------------------------------------------------
# Points to the FreeCADCmd.exe built from the freecad/ submodule
FREECAD_PATH=../freecad/build/bin/FreeCADCmd.exe

# ---------------------------------------------------------------------------
# SolidCraft engine (only read when PISTOLA_CAD_ENGINE=solidcraft)
# ---------------------------------------------------------------------------
# Leave unset to auto-resolve: any .tools/solidcraft-*/ portable build first,
# then the default install under %ProgramFiles%\SolidCraft.
# SOLIDCRAFT_CLI_PATH=C:\Program Files\SolidCraft\solidcraft-cli.exe

# headless (default) runs a fresh in-process session per request and is the
# reproducible, CI-safe path. bridged drives an already-running SolidCraft
# window over its loopback control channel so you can watch it model.
SOLIDCRAFT_MODE=headless

# Bridged mode only. The port defaults to 27878, and the token is read from the
# per-launch token file. Prefer the env var over a command-line flag: argv is
# visible to other users on the machine.
# SOLIDCRAFT_CONTROL_PORT=27878
# SOLIDCRAFT_CONTROL_TOKEN=

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------
ARTIFACT_DIR=.artifacts
PORT=7878
