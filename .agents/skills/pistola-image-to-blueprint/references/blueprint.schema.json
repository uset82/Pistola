{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pistola/blueprint.schema.json",
  "title": "Pistola object blueprint",
  "type": "object",
  "required": ["slug", "title", "style", "scale", "parts"],
  "additionalProperties": false,
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "style": { "enum": ["toy", "low-poly", "realistic", "architectural"] },
    "concept": { "type": "string", "description": "Path of the approved concept image, e.g. .pistola/studio/<slug>/concept.png" },
    "scale": {
      "type": "object",
      "required": ["anchor", "value_m"],
      "additionalProperties": false,
      "properties": {
        "anchor": { "type": "string", "description": "Which real dimension sets the scale, e.g. 'overall length'" },
        "axis": { "enum": ["x", "y", "z"] },
        "value_m": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "views": {
      "type": "object",
      "description": "Traced silhouettes from trace_silhouette.py (points in meters).",
      "additionalProperties": false,
      "properties": {
        "front": { "$ref": "#/$defs/outline" },
        "side": { "$ref": "#/$defs/outline" },
        "top": { "$ref": "#/$defs/outline" }
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/color" }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": { "$ref": "#/$defs/part" }
    },
    "acceptance": {
      "type": "array",
      "description": "Checks the critic uses, e.g. 'hull length is about 2.5x its height'.",
      "items": { "type": "string" }
    },
    "assumptions": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "vec2": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
    "vec3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "outline": {
      "type": "object",
      "required": ["points"],
      "properties": {
        "points": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/vec2" } },
        "width_m": { "type": "number" },
        "height_m": { "type": "number" },
        "origin": { "enum": ["bottom-center", "center"] }
      }
    },
    "part": {
      "type": "object",
      "required": ["id", "name", "shape", "dims_m", "position_m", "parent"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "description": "What the part is for: body, cabin, mast, wheel, trim..." },
        "shape": {
          "enum": ["primitive", "profile-extrude", "silhouette-intersection", "revolve", "cad-brief", "mac", "architecture"]
        },
        "primitive": { "enum": ["box", "sphere", "cylinder", "cone", "torus", "capsule", "wedge"] },
        "profile": {
          "type": "object",
          "description": "profile-extrude: a closed polygon on a plane, extruded by depth_m.",
          "required": ["plane", "points", "depth_m"],
          "properties": {
            "plane": { "enum": ["XY", "XZ", "YZ"] },
            "points": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/vec2" } },
            "depth_m": { "type": "number", "exclusiveMinimum": 0 },
            "source": { "type": "string", "description": "Which traced view it came from" }
          }
        },
        "intersect": {
          "type": "object",
          "description": "silhouette-intersection: extrude two traced views across the part and keep the overlap.",
          "required": ["views"],
          "properties": {
            "views": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "enum": ["front", "side", "top"] } }
          }
        },
        "revolve": {
          "type": "object",
          "required": ["profile", "axis"],
          "properties": {
            "profile": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/vec2" } },
            "axis": { "enum": ["X", "Y", "Z"] },
            "angle_deg": { "type": "number" }
          }
        },
        "dims_m": { "$ref": "#/$defs/vec3", "description": "Bounding size [x width, y height, z depth] in meters" },
        "position_m": { "$ref": "#/$defs/vec3", "description": "Bottom-center of the part, relative to the object origin on the floor" },
        "rotation_deg": { "$ref": "#/$defs/vec3" },
        "color": { "$ref": "#/$defs/color" },
        "parent": { "type": ["string", "null"] },
        "source_view": { "enum": ["front", "side", "top", "concept"] },
        "notes": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "shape": { "const": "primitive" } } }, "then": { "required": ["primitive"] } },
        { "if": { "properties": { "shape": { "const": "profile-extrude" } } }, "then": { "required": ["profile"] } },
        { "if": { "properties": { "shape": { "const": "silhouette-intersection" } } }, "then": { "required": ["intersect"] } },
        { "if": { "properties": { "shape": { "const": "revolve" } } }, "then": { "required": ["revolve"] } }
      ]
    }
  }
}
