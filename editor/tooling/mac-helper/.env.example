# Pistola MAC Helper
#
# Thin FastAPI sidecar that runs a user-installed Multi-Agent-CAD clone.
# Does not vendor MAC. Point PISTOLA_MAC_ROOT at your clone.
#
# Quick start (mock, no MAC install):
#   set PISTOLA_MAC_HELPER_RUNTIME=mock
#   uvicorn main:app --host 127.0.0.1 --port 7879
#
# Real MAC:
#   1. Clone https://github.com/Pan-Chera/Multi-Agent-CAD
#   2. conda env create -f environment.yml && conda activate multi_agent_cad
#   3. pip install --no-deps "aider-chat==0.82.3"
#   4. set PISTOLA_MAC_ROOT and PISTOLA_MAC_PYTHON
#   5. set OPENROUTER_API_KEY (or use .pistola-ai.local.json)
#   6. uvicorn main:app --host 127.0.0.1 --port 7879

PISTOLA_MAC_HELPER_HOST=127.0.0.1
PISTOLA_MAC_HELPER_PORT=7879
PISTOLA_MAC_HELPER_URL=http://127.0.0.1:7879
# python | mock | external
PISTOLA_MAC_HELPER_RUNTIME=mock
# PISTOLA_MAC_ROOT=C:\path\to\Multi-Agent-CAD
# PISTOLA_MAC_PYTHON=C:\path\to\python.exe
# OPENROUTER_API_KEY=
# PISTOLA_MAC_MODEL=openrouter/free
# PISTOLA_MAC_JOB_TIMEOUT_SECONDS=1800
