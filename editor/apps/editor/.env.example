# Active local env file for the Next app: copy this file to `.env.local`

# App-managed email/password auth
POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
BETTER_AUTH_SECRET=

PISTOLA_CAD_HELPER_URL=http://127.0.0.1:7878
PISTOLA_CAD_HELPER_RUNTIME=python
NEXT_PUBLIC_CAD_HELPER_URL=http://127.0.0.1:7878
# Canner deployment: use externally hosted helper services and allow only the
# registered OpenAI Sites origin to make authenticated cross-origin CAD calls.
# PISTOLA_CAD_HELPER_URL=https://cad-helper.example.com
# PISTOLA_CAD_HELPER_RUNTIME=external
# PISTOLA_MAC_HELPER_URL=https://mac-helper.example.com
# PISTOLA_MAC_HELPER_RUNTIME=external
# PISTOLA_PUBLIC_EDITOR_ORIGIN=https://your-project.chatgpt.site
# Optional override when `PISTOLA_CAD_HELPER_RUNTIME=python`.
# If omitted, the helper auto-detects common integrated outputs such as
# editor/third_party/FreeCAD/build/release/bin/FreeCADCmd.exe,
# editor/third_party/FreeCAD/build/debug/bin/FreeCADCmd.exe, or
# editor/third_party/FreeCAD/.pixi/envs/default/Library/bin/FreeCADCmd.exe.
FREECAD_PATH=C:\\Users\\carlos\\PROYECTOS\\pistolacodex\\editor\\third_party\\FreeCAD\\build\\release\\bin\\FreeCADCmd.exe

# Multi-Agent-CAD sidecar (advanced text-to-CAD). Do not vendor MAC — clone it separately.
# https://github.com/Pan-Chera/Multi-Agent-CAD
PISTOLA_MAC_HELPER_URL=http://127.0.0.1:7879
# python | mock | external  (use mock to exercise plumbing without a MAC install)
PISTOLA_MAC_HELPER_RUNTIME=mock
# PISTOLA_MAC_ROOT=C:\\path\\to\\Multi-Agent-CAD
# PISTOLA_MAC_PYTHON=C:\\path\\to\\conda\\envs\\multi_agent_cad\\python.exe
# PISTOLA_MAC_MODEL=openrouter/free
# PISTOLA_MAC_JOB_TIMEOUT_SECONDS=1800

# Local IDE / MCP automation: choose one mode.
# A development-only bearer token authorizes local MCP → Next.js calls; it does not authorize a browser workspace.
# PISTOLA_LOCAL_API_TOKEN=dev-local-token
# Without an auth DB or token, set this in the editor app environment to allow a local
# browser workspace and MCP. It is development-only and must not be used in production.
# PISTOLA_ALLOW_UNAUTHENTICATED_API=1
# PISTOLA_BASE_URL=http://127.0.0.1:3002

# AI provider selection
# Supported values: openai, openrouter, fallback
PISTOLA_AI_PROVIDER=openrouter
# Integrated assistant default (codex | openrouter | openai).
# When `.pistola-ai.local.json` installs OpenRouter, it wins over Codex default.
# PISTOLA_ASSISTANT_AI_PROVIDER=openrouter
# Optional per-surface overrides:
# PISTOLA_CAD_AI_PROVIDER=openrouter

# Recommended direct OpenAI setup
# The Codex assistant can also use cached local Codex login state when OPENAI_API_KEY is unset.
OPENAI_API_KEY=
PISTOLA_ASSISTANT_MODEL=gpt-5.3-codex
PISTOLA_ASSISTANT_REASONING_EFFORT=medium
PISTOLA_CAD_MODEL=openrouter/free
# Optional: set the full Responses endpoint only if you need a non-default OpenAI-compatible base URL.
# PISTOLA_ASSISTANT_AI_BASE_URL=https://api.openai.com/v1/responses
# PISTOLA_CAD_AI_BASE_URL=https://api.openai.com/v1/responses

# Optional OpenRouter alternative (also installable via CAD panel Settings / pistola_configure_model)
OPENROUTER_API_KEY=
# If you switch `PISTOLA_AI_PROVIDER` to `openrouter`, also update the models/base URLs accordingly.
# PISTOLA_ASSISTANT_MODEL=openrouter/free
# PISTOLA_CAD_MODEL=openrouter/free
# PISTOLA_ASSISTANT_AI_BASE_URL=https://openrouter.ai/api/v1
# PISTOLA_CAD_AI_BASE_URL=https://openrouter.ai/api/v1
PISTOLA_ASSISTANT_AI_HTTP_REFERER=http://127.0.0.1:3002
PISTOLA_ASSISTANT_AI_TITLE=Pistola
PISTOLA_CAD_AI_HTTP_REFERER=http://127.0.0.1:3002
PISTOLA_CAD_AI_TITLE=Pistola

# Legacy OpenRouter alias kept for backward compatibility
PISTOLA_CAD_AI_API_KEY=
